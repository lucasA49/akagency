# ─── Serveur ────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── Base de données MySQL ───────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=votre_mot_de_passe
DB_NAME=ak_agency

# ─── JWT ─────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEZ_CE_SECRET_AVEC_UNE_VALEUR_ALEATOIRE_LONGUE
JWT_EXPIRES_IN=24h

# ─── Nodemailer (Gmail) ───────────────────────
# Pour Gmail : activez "Mots de passe d'application" dans votre compte Google
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=lucasaksu@gmail.com
MAIL_PASS=votre_app_password_gmail
MAIL_FROM="AK Agency <lucasaksu@gmail.com>"

# ─── Reset mot de passe ───────────────────────
RESET_TOKEN_EXPIRES_MINUTES=60
